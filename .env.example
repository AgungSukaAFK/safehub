# Supabase (sesi user + RLS). JANGAN pasang secret key Supabase di app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Web Push (VAPID) - satu pasang per app: npx web-push generate-vapid-keys
# Public key: buildtime + runtime. Private key: RUNTIME SAJA (Coolify: buildtime off).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Opsional: URL dasar sistem maintenance (https). Bila diisi, /maintenance menampilkan tombol "Buka sistem maintenance".
MAINTENANCE_SYSTEM_URL=
